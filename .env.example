# Заполните локально / в секретах deployment. Не коммитьте настоящий .env.
BOT_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Существующий закрытый канал. Сохраните фактическое значение сервера.
CHANNEL_ID=-1002468345259
PROJECT_KEY=creative_brain
# Основной Telegram user ID владельца. Введите только числовой ID.
ADMIN_ID=
# Совместимость: если ADMIN_ID пуст, используется ADMIN_IDS, затем ADMINS.
# Значения из разных переменных не объединяются.
ADMIN_IDS=
# Используется для первоначального заполнения settings.offer_url.
# Сохранённая в БД оферта имеет приоритет; далее меняйте её через /admin.
OFFER_URL=
# Без @. Нужен для возврата в бот, если YOOKASSA_RETURN_URL не задан.
BOT_USERNAME=
# Если URL возврата уже задан на сервере, сохраните его.
YOOKASSA_RETURN_URL=
# Укажите прежний постоянный SQLite-файл. Не создавайте пустую БД при обновлении.
DB_PATH=credits.db
FOLLOWUP_ENABLED=true
# Используется один раз для начального заполнения ID группы активности.
# Дальше меняйте через /admin. 0 отключает учёт сообщений и файлов.
ACTIVITY_CHAT_ID=0
# Увеличивайте при изменении условий по прежнему URL.
OFFER_VERSION=1
# Ссылка на урок хранится в SQLite settings.lead_magnet_url.
# Установите через /admin → 🎬 Лид-магнит.
# Автопродление по умолчанию выключено; включение — отдельно в /admin.
